{
  "expo": {
    "name": "Fync",
    "slug": "fync-app",
    "scheme": "fync",
    "version": "1.0.0",
    "icon": "./assets/square_logo.png",
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone for interview answers."
        }
      ],
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Fync to access your photos",
          "videosPermission": "Allow Fync to access your videos",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-web-browser"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Used to show campus crowd density",
        "NSLocationAlwaysUsageDescription": "Used to show campus crowd density"
      }
    },
    "android": {
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ],
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/square_logo.png",
        "backgroundColor": "#000"
      },
      "package": "com.anonymous.client",
      "softwareKeyboardLayoutMode": "pan"
    }
  }
}
