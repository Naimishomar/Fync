{
  "expo": {
    "name": "Fync",
    "slug": "fync-app",
    "scheme": "fync",
    "version": "1.0.0",
    "icon": "./assets/square_logo.png",
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone for interview answers."
        }
      ],
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Fync to access your photos",
          "videosPermission": "Allow Fync to access your videos",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-web-browser",
      "expo-router"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Used to show campus crowd density",
        "NSLocationAlwaysUsageDescription": "Used to show campus crowd density"
      }
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/square_logo.png",
        "backgroundColor": "#000"
      },
      "package": "com.anonymous.client",
      "softwareKeyboardLayoutMode": "pan"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "676601fd-e13d-4c84-b51e-0a9639a27b34"
      }
    },
    "owner": "nexus_91"
  }
}
