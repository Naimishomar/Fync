{
  "expo": {
    "name": "Fync",
    "slug": "fync",
    "scheme": "fync",
    "version": "1.0.0",
    "icon": "./assets/Fync.png",
    "experiments": {
      "tsconfigPaths": true
    },
    "notification": {
      "icon": "./assets/Fync.png",
      "color": "#f97316"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Fync uses your photos so you can add them to posts, chats and your profile.",
          "cameraPermission": "Fync uses your camera so you can take photos for posts, chats and your profile."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone for interview answers."
        }
      ],
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "Fync uses your photos so you can save converted PDF pages to your gallery.",
          "videosPermission": "Fync uses your videos so you can pick one to post as a Short.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-web-browser",
      "react-native-compressor",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          },
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Fync to access your camera for video calls.",
          "microphonePermission": "Allow Fync to access your microphone for audio calls."
        }
      ],
      "@react-native-firebase/messaging",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000",
      "barStyle": "dark-content"
    },
    "splash": {
      "image": "./assets/Fync.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F2EC"
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.naimishomar.fync",
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": [
        "applinks:fync-api.duckdns.org"
      ],
      "backgroundColor": "#F5F2EC"
    },
    "android": {
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "fync-api.duckdns.org",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.naimishomar.fync",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 1,
      "backgroundColor": "#F5F2EC",
      "blockedPermissions": [
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.NFC"
      ],
      "allowBackup": false
    },
    "extra": {
      "eas": {
        "projectId": "2ac54640-5d53-44b3-994b-5cefbc77b576"
      }
    },
    "owner": "naimishomar",
    "newArchEnabled": true,
    "backgroundColor": "#F5F2EC",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/2ac54640-5d53-44b3-994b-5cefbc77b576"
    }
  }
}
