{
  "expo": {
    "name": "Fync",
    "slug": "fync",
    "scheme": "fync",
    "version": "1.0.0",
    "icon": "./assets/Fync.png",
    "experiments": {
      "tsconfigPaths": true
    },
    "notification": {
      "icon": "./assets/Fync.png",
      "color": "#ffffff"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone for interview answers."
        }
      ],
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Fync to access your photos",
          "videosPermission": "Allow Fync to access your videos",
          "audioPermission": "Allow Fync to access your audio",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-web-browser",
      "react-native-compressor",
      "expo-notifications",
      "expo-build-properties",
      "expo-video",
      "@react-native-community/datetimepicker"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:fync-api.duckdns.org"
      ],
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Used to show campus crowd density",
        "NSLocationAlwaysUsageDescription": "Used to show campus crowd density"
      }
    },
    "android": {
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "fync-api.duckdns.org",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/Fync.png",
        "backgroundColor": "#000"
      },
      "package": "com.naimishomar.fync",
      "softwareKeyboardLayoutMode": "adjustResize"
    },
    "extra": {
      "eas": {
        "projectId": "2ac54640-5d53-44b3-994b-5cefbc77b576"
      }
    },
    "owner": "naimishomar",
    "newArchEnabled": false
  }
}
