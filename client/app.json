{
  "expo": {
    "name": "Fync",
    "slug": "fync",
    "scheme": "fync",
    "version": "1.0.0",
    "icon": "./assets/Fync.png",
    "experiments": {
      "tsconfigPaths": true
    },
    "notification": {
      "icon": "./assets/Fync.png",
      "color": "#f97316"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone for interview answers."
        }
      ],
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Fync to access your photos",
          "videosPermission": "Allow Fync to access your videos",
          "audioPermission": "Allow Fync to access your audio",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-web-browser",
      "react-native-compressor",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "allowBackup": false,
            "usesCleartextTraffic": false,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Fync to access your camera for video calls.",
          "microphonePermission": "Allow Fync to access your microphone for audio calls."
        }
      ],
      "@react-native-firebase/messaging",
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000",
      "barStyle": "dark-content"
    },
    "splash": {
      "image": "./assets/Fync.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC"
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.naimishomar.fync",
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": [
        "applinks:fync-api.duckdns.org"
      ],
      "backgroundColor": "#F8FAFC"
    },
    "android": {
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "fync-api.duckdns.org",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.naimishomar.fync",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 1,
      "backgroundColor": "#F8FAFC"
    },
    "extra": {
      "eas": {
        "projectId": "2ac54640-5d53-44b3-994b-5cefbc77b576"
      }
    },
    "owner": "naimishomar",
    "newArchEnabled": true,
    "backgroundColor": "#F8FAFC"
  }
}
