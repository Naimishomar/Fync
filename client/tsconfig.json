{
  "extends": "expo/tsconfig.base",
  "include": [
    "env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "typeRoots": [
      "./types",
      "./node_modules/@types"
    ]
  }
}